---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { allPosts, allPages, categories, fmt, settings, REGISTER_URL } from '../content/site';
export const getStaticPaths = () => [
  ...allPosts.map(p => ({ params: { slug: p.slug }, props: { kind: 'post', p } })),
  ...allPages.map(e => ({ params: { slug: e.id }, props: { kind: 'page', e } })),
];
const { kind, p, e } = Astro.props;
const entry = kind === 'post' ? p.entry : e;
const { Content } = await render(entry);
const d = entry.data;
const cn = kind === 'post' ? p.cats.map(s => categories.find(c => c.slug === s)).filter(Boolean) : [];
const img = d.image;
const showImg = img && !(kind === 'post' && p.hasImg);
---
<Base title={d.title} description={kind === 'post' ? p.description : d.description} image={img ?? undefined}>
<article class={`article page-${entry.id}${kind === 'page' && d.showRegisterCta ? ' has-sticky' : ''}`}><div class="narrow">
{kind === 'post' && <div class="meta">{fmt(p.date)} · {cn.map((c,i)=>(<><a href={`/category/${c.slug}/`}>{c.name}</a>{i + 1 < cn.length ? ', ' : ''}</>))}</div>}
<h1>{d.title}</h1>
{kind === 'page' && d.showRegisterCta && <div class="cta-top"><div><strong>{settings.classCard.label}</strong><span>{settings.classCard.text}</span></div><a class="btn pulse" href={REGISTER_URL}>{settings.classCard.buttonText}</a></div>}
{showImg && <img class={kind === 'page' ? 'page-hero-img' : ''} src={img} alt="" style="margin:0 auto 1.5em">}
<div class="body"><Content /></div></div>
{kind === 'page' && d.showRegisterCta && <a class="sticky-register btn pulse" href={REGISTER_URL}>Register for Kids Classes →</a>}
</article>
</Base>
