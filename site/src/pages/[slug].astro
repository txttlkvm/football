---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { render } from 'astro:content';
import { allPosts, allPages, categories, fmt, settings, REGISTER_URL, renderCtx } from '../content/site';
import { blocksHtml } from '../lib/render.mjs';
export const getStaticPaths = () => [
  ...allPosts.map((p, i) => ({ params: { slug: p.slug }, props: { kind: 'post', p, i } })),
  ...allPages.filter(e => e.id !== 'home').map(e => ({ params: { slug: e.id }, props: { kind: 'page', e } })),
];
const { kind, p, e, i } = Astro.props;
const entry = kind === 'post' ? p.entry : e;
const { Content } = await render(entry);
const d = entry.data;
const plain = (entry.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)|\{\{<[^>]*>\}\}|\[([^\]]*)\]\([^)]*\)|[#*_`>]/g, '$1').replace(/\s+/g, ' ').trim();
const snippet = plain.length > 155 ? plain.slice(0, 155).replace(/\s+\S*$/, '') + '…' : plain;
const description = (kind === 'post' ? p.description : d.description) || snippet;
const cn = kind === 'post' ? p.cats.map(s => categories.find(c => c.slug === s)).filter(Boolean) : [];
const img = d.image;
const showImg = !!img;
const url = new URL(Astro.url.pathname, Astro.site).href;
const minutes = Math.max(1, Math.round(plain.split(' ').length / 200));
const related = kind === 'post' ? allPosts.filter(x => x.slug !== p.slug && x.cats.some(c => p.cats.includes(c))).slice(0, 3) : [];
const newer = kind === 'post' ? allPosts[i - 1] : null, older = kind === 'post' ? allPosts[i + 1] : null;
const jsonLd = kind === 'post' ? { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, datePublished: p.date.toISOString(), image: img ? new URL(img, Astro.site).href : undefined, author: { '@type': 'Person', name: 'Diamond Solomon' }, publisher: { '@type': 'Organization', name: settings.siteTitle }, mainEntityOfPage: url, description } : null;
const enc = encodeURIComponent;
const blocks = kind === 'page' ? blocksHtml(d.blocks, renderCtx) : '';
const blocksOnly = kind === 'page' && d.layout === 'blocks';
---
<Base title={d.title} description={description} image={img ?? undefined} ogType={kind === 'post' ? 'article' : 'website'} jsonLd={jsonLd}>
{blocksOnly ? <Fragment set:html={blocks} /> : <article class={`article page-${entry.id}${kind === 'page' && d.showRegisterCta ? ' has-sticky' : ''}`}><div class="narrow">
{kind === 'post' && <div class="meta">{fmt(p.date)} · {cn.map((c,k)=>(<><a href={`/category/${c.slug}/`}>{c.name}</a>{k + 1 < cn.length ? ', ' : ''}</>))} · <span class="reading">{minutes} min read</span></div>}
<h1>{d.title}</h1>
{kind === 'page' && d.showRegisterCta && <div class="cta-top"><div><strong>{settings.classCard.label}</strong><span>{settings.classCard.text}</span></div><a class="btn pulse" href={REGISTER_URL}>{settings.classCard.buttonText}</a></div>}
{showImg && <img class={kind === 'page' ? 'page-hero-img' : ''} src={img} alt={kind === 'post' ? d.title : ''} style={`margin:0 auto 1.5em${d.imageFocus ? `;object-position:${({top:"50% 0%",center:"50% 50%",bottom:"50% 100%",left:"0% 50%",right:"100% 50%",face:"50% 25%"})[d.imageFocus] ?? "50% 50%"}` : ""}`}>}
<div class="body"><Content /></div></div>
{kind === 'post' && <div class="post-extra">
<div class="share"><strong>Share</strong>
<a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} rel="noopener" target="_blank">Facebook</a>
<a href={`https://pinterest.com/pin/create/button/?url=${enc(url)}&description=${enc(d.title)}`} rel="noopener" target="_blank">Pinterest</a>
<a href={`https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(d.title)}`} rel="noopener" target="_blank">X</a>
<a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
<button type="button" data-copy={url}>Copy link</button></div>
<div class="author"><p><strong>Diamond Solomon</strong> — wife, mother and chef of her household, sharing what God has taught her about marriage, motherhood and meals. <a href="/about-me/">About me →</a></p></div>
{(newer || older) && <nav class="pn" aria-label="More posts">{older ? <a href={`/${older.slug}/`}><span>Older</span>{older.title}</a> : <i></i>}{newer ? <a class="next" href={`/${newer.slug}/`}><span>Newer</span>{newer.title}</a> : <i></i>}</nav>}
{related.length > 0 && <section class="related"><h2>You might also like</h2><div class="grid">{related.map(r => <PostCard post={r} />)}</div></section>}
</div>}
{kind === 'page' && d.showRegisterCta && <a class="sticky-register btn pulse" href={REGISTER_URL}>{settings.classCard.stickyText}</a>}
</article>}
{!blocksOnly && blocks && <Fragment set:html={blocks} />}
<script is:inline>document.querySelectorAll('[data-copy]').forEach(function(b){b.addEventListener('click',function(){var t=b.getAttribute('data-copy');(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(function(){b.textContent='Copied!'}).catch(function(){window.prompt('Copy this link',t)})})})</script>
</Base>
