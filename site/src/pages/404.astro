---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts } from '../content/site';
---
<Base title="Page not found" description="That page isn't here, but there's plenty more to read.">
<section class="nf wrap"><h1>Oops</h1><h2>We couldn't find that page.</h2><p>It may have moved. Here are a few places to start.</p>
<p><a class="btn" href="/">Go to the home page</a></p></section>
<section class="section cream"><div class="wrap"><h2 class="title">Recent Posts</h2><div class="grid">{allPosts.slice(0,3).map(p=><PostCard post={p}/>)}</div></div></section>
</Base>
