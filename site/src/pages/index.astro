---
import Base from '../layouts/Base.astro';
import { allPages, renderCtx } from '../content/site';
import { blocksHtml } from '../lib/render.mjs';
const home = allPages.find(e => e.id === 'home');
---
<Base title="Home" description={home?.data.description}>
<Fragment set:html={blocksHtml(home?.data.blocks, renderCtx)} />
</Base>
