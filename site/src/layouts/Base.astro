---
import '../styles/global.css';
import { nav } from '../content/site';
const { title, description = "Diamond's blog on Marriage, Motherhood & Meals — sharing the knowledge God has given.", image = '/img/logo.png' } = Astro.props;
const full = title === 'Home' ? 'Motherhood Marriage Meals – Diamond’s Blog' : `${title} – Motherhood Marriage Meals`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={new URL(path, Astro.site)}><link rel="icon" href="/img/logo.png">
<meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="wrap">
<a class="brand" href="/"><img src="/img/logo.png" alt="Marriage-Motherhood-Meals" width="900" height="197"></a>
<button class="toggle" aria-expanded="false" aria-controls="menu" id="tg">Menu</button>
<nav aria-label="Main menu"><ul class="menu" id="menu">
{nav.map(i=>(<li><a href={i.href} aria-current={path===i.href?'page':undefined}>{i.label}{i.children?' ▾':''}</a>
{i.children&&<ul class="sub">{i.children.map(c=>(<li><a href={c.href}>{c.label}</a></li>))}</ul>}</li>))}
</ul></nav></div></header>
<main id="main"><slot/></main>
<footer class="footer"><img src="/img/logo.png" alt="Marriage-Motherhood-Meals" width="900" height="197" loading="lazy"><p>Diamond's Blog<br>© {new Date().getFullYear()} All rights reserved</p></footer>
<script is:inline>const t=document.getElementById('tg'),m=document.getElementById('menu');t.addEventListener('click',()=>{const o=m.classList.toggle('open');t.setAttribute('aria-expanded',o)})</script>
</body></html>
