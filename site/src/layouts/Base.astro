---
import '../styles/global.css';
import { nav, REGISTER_URL, settings } from '../content/site';
const { title, description = "Diamond's blog on Marriage, Motherhood & Meals — sharing the knowledge God has given.", image = '/og.png', ogType = 'website', jsonLd = null } = Astro.props;
const full = title === 'Home' ? `${settings.siteTitle} – ${settings.tagline.replace(/'/g, '\u2019')}` : `${title} – ${settings.siteTitle}`;
const t = settings.theme;
const fontsUrl = 'https://fonts.googleapis.com/css2?' + [...new Set([t.headingFont, t.bodyFont])].map(f => `family=${f.replace(/ /g, '+')}:wght@400;500;600;700`).join('&') + '&display=swap';
const themeCss = `html:root{--pink:${t.accent};--ink:${t.dark};--text:${t.text};--cream:${t.soft};--font-head:"${t.headingFont}",system-ui,sans-serif;--font-body:"${t.bodyFont}",system-ui,sans-serif}`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={new URL(path, Astro.site)}><link rel="icon" type="image/png" href="/favicon.png"><link rel="apple-touch-icon" href="/favicon.png">
<meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:type" content={ogType}><meta property="og:site_name" content={settings.siteTitle}><meta property="og:url" content={new URL(path, Astro.site)}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content={new URL(image, Astro.site)}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={fontsUrl} rel="stylesheet"><style set:html={themeCss}></style>
{jsonLd&&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
<link rel="alternate" type="application/rss+xml" title={settings.siteTitle} href="/rss.xml">
<script is:inline>document.documentElement.classList.add("js")</script>
</head><body>
<a class="skip" href="#main">Skip to content</a>
{settings.announcement.show&&<div class="announce" id="announce" hidden><p><strong>{settings.announcement.text}</strong> <a href={REGISTER_URL}>{settings.announcement.linkText}</a></p><button type="button" id="ax" aria-label="Dismiss announcement">×</button></div>}
<header class="site-header"><div class="wrap">
<a class="brand" href="/"><img src={settings.logo} alt={settings.siteTitle} width="900" height="197"></a>
<a class="btn hdr-register pulse" href={REGISTER_URL}>Register</a>
<button class="toggle" aria-expanded="false" aria-controls="menu" id="tg">Menu</button>
<nav aria-label="Main menu"><ul class="menu" id="menu">
<li class="nav-mobile-cta"><a class="btn pulse" href="/home-chefs/">{settings.mobileCta}</a></li>
{nav.map(i=>(<li><a href={i.href} aria-current={path===i.href?'page':undefined}>{i.label}{i.children?' ▾':''}</a>
{i.children&&<ul class="sub">{i.children.map(c=>(<li><a href={c.href}>{c.label}</a></li>))}</ul>}</li>))}
<li class="nav-cta"><a class="btn pulse" href={REGISTER_URL}>Register</a></li></ul></nav></div></header>
<main id="main"><slot/></main>
<footer class="footer"><img src={settings.logo} alt={settings.siteTitle} width="900" height="197" loading="lazy"><p>{settings.tagline}<br>© {new Date().getFullYear()} {settings.footerText}</p>{settings.social.length>0&&<p class="social">{settings.social.map(x=>(<a href={x.url} rel="noopener">{x.label}</a>))}</p>}</footer>
<script is:inline>const a=document.getElementById('announce');if(a){try{if(!sessionStorage.getItem('ax'))a.hidden=false}catch(e){a.hidden=false}document.getElementById('ax').addEventListener('click',()=>{a.hidden=true;try{sessionStorage.setItem('ax','1')}catch(e){}})}const t=document.getElementById('tg'),m=document.getElementById('menu');t.addEventListener('click',()=>{const o=m.classList.toggle('open');t.setAttribute('aria-expanded',o)})</script>
<script is:inline>(function(){var hd=document.querySelector('.site-header');var sc=function(){hd.classList.toggle('scrolled',window.scrollY>8)};sc();window.addEventListener('scroll',sc,{passive:true});
document.querySelectorAll('.grid').forEach(function(g){Array.prototype.forEach.call(g.children,function(c,i){c.style.setProperty('--d',(i%6)*70+'ms')})});
if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
document.querySelectorAll('.card,.feature,.title,.about-block,.about-img,.blk-gallery figure,.cta-band,.blk-columns .col,.it,details,.blk-quote blockquote,.article .body img,.article .body video,.footer img').forEach(function(el){el.classList.add('reveal');io.observe(el)})})()</script>
</body></html>
