---
import { fmt } from '../content/site';
const { post } = Astro.props;
---
<a class="card" href={`/${post.slug}/`}>{post.img?<img src={post.img} alt="" loading="lazy">:<div class="ph"></div>}
<div class="b"><div class="meta">{fmt(post.date)}</div><h3>{post.title}</h3>{post.excerpt&&<p>{post.excerpt.slice(0,110)}…</p>}</div></a>
